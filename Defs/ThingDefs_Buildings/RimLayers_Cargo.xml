 <modExtensions><li Class="RimLayers.Cargo.CargoProperties"><capacity>3</capacity><handlingTicks>30</handlingTicks><manualTicksPerFloor>180</manualTicksPerFloor><electricTicksPerFloor>45</electricTicksPerFloor><electricSetupTicks>30</electricSetupTicks><idleWatts>30</idleWatts><runningWatts>120</runningWatts><electric>false</electric><shaft>false</shaft><station>false</station><direction>1</direction></li></modExtensions>
 
