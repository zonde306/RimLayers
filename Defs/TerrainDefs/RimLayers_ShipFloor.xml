 <texturePath>Terrain/Surfaces/Substructure/Substructure</texturePath><isFoundation>true</isFoundation><layerable>false</layerable>
 <edgeType>Hard</edgeType><renderPrecedence>399</renderPrecedence><designationCategory>Odyssey</designationCategory>
