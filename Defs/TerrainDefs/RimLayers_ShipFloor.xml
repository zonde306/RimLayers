 <affordances Inherit="False"><li>Light</li><li>Medium</li><li>Heavy</li><li>Walkable</li><li>RL_FloorSupport</li><li>Substructure</li></affordances>
 <tags><li>Substructure</li></tags><statBases><WorkToBuild>600</WorkToBuild><Flammability>0</Flammability></statBases>
 <costList><GravlitePanel>1</GravlitePanel><Steel>4</Steel></costList><resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
 <placeWorkers><li>RimLayers.Structure.PlaceWorker_LayerSupport</li></placeWorkers>
</TerrainDef></Defs>
