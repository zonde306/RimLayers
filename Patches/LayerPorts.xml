  <!-- ============================== Dubs Rimatomics =============================
       Rimatomics' own "wires" and "data cables" are not native PowerNets: HighVoltage and Loom are
       two mediums of its UniversalPipeMapComp, so they get pipe terminals like everything else.
       Every concrete Rimatomics def is a RimatomicsThingDef, and the parent chain requires the same
       Class on the child, hence Class="Rimatomics.RimatomicsThingDef" on each of these five.
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="coolingPipe"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <ThingDef ParentName="RimatomicsPipeBase" Class="Rimatomics.RimatomicsThingDef">
          <defName>RL_RimatomicsCoolingRiser</defName>
          <label>vertical coolant riser</label>
          <description>A coolant pipe that also joins the coolant network of the layer directly above and below it. Build one on each layer at the same position; a riser only spans one layer, so a three-layer shaft needs one on every layer. It is an ordinary coolant pipe otherwise.</description>
          <graphicData>
            <texPath>Rimatomics/Things/RimatomicsBuildings/coolingPipe_Atlas</texPath>
            <color>(0.45,0.8,1)</color>
          </graphicData>
          <building>
            <blueprintGraphicData>
              <texPath>Rimatomics/Things/RimatomicsBuildings/coolingPipe_AtlasBP</texPath>
            </blueprintGraphicData>
          </building>
          <uiIconPath>Rimatomics/UI/CoolingPipe</uiIconPath>
          <uiIconScale>0.8</uiIconScale>
          <comps>
            <li Class="Rimatomics.CompProperties_Pipe">
              <mode>Cooling</mode>
            </li>
            <li Class="RimLayers.Compatibility.CompProperties_LayerPort" />
          </comps>
          <uiOrder>2065</uiOrder>
        </ThingDef>
      </value>
    </match>
  </Operation>

