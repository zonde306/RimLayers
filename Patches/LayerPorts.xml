<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Cross-layer pipe terminals for the Dubs family (Dubs Bad Hygiene, Dubs Central Heating,
    Rimefeller, Dubs Rimatomics).

    Each terminal is a REAL pipe of the owning mod: it inherits that mod's own abstract pipe base and
    carries that mod's own CompProperties_Pipe with the right <mode>. That is mandatory, not stylistic:
    all four mods let only one pipe comp occupy a cell (they log
    "More than 1 pipe comp in the same cell ... things with pipes cannot overlap!" and Dubs even
    destroys the overlapping pipe), so a separate connector building stacked on a pipe would break
    their registration. Being a real pipe, the mod registers it in its own net exactly like any other
    pipe; RimLayers.Compatibility.CompLayerPort only opts that cell into the vertical projection of
    the flood fill.

    Gating uses PatchOperationConditional on the other mod's own def rather than
    PatchOperationFindMod, because PatchOperationFindMod compares ModMetaData.Name (the display name)
    and not the packageId; the def test is also independent of translations and local forks. One
    unique defName per package is used as the probe because Dubs Bad Hygiene and Dubs Central Heating
    both define an "airPipe", so a shared probe would fire for the wrong mod (and with both mods
    loaded only one of those two conflicting defs survives, so the probe must not be the air pipe
    itself: the air risers are gated on a def only their own package defines).

    Inheritance note: these defs inherit the ABSTRACT pipe base, never the concrete pipe, because a
    <comps> child only appends <li> entries to the parent copy. Inheriting a concrete pipe would
    therefore end up with two pipe comps on one thing.

    The graphicData block only overrides <color>: the rest (texPath, linkType/linkFlags, damageData)
    is merged from the parent, so each terminal still connects visually to its own mod's pipes.
  -->

  <!-- ============================ Dubs Bad Hygiene ============================ -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="sewagePipeStuff"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <ThingDef ParentName="DubsDirtyPipeBase">
          <defName>RL_HygieneSewageRiser</defName>
          <label>vertical sewage riser</label>
          <description>A sewage pipe that also joins the sewage network of the layer directly above and below it. Build one on each layer at the same position; a riser only spans one layer, so a three-layer shaft needs one on every layer. It is an ordinary sewage pipe otherwise.</description>
          <graphicData>
            <color>(0.45,0.8,1)</color>
          </graphicData>
          <uiIconPath>DBH/UI/Plumbing</uiIconPath>
          <uiIconScale>0.8</uiIconScale>
          <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>120</WorkToBuild>
          </statBases>
          <costList>
            <Steel>8</Steel>
          </costList>
          <comps>
            <li Class="DubsBadHygiene.CompProperties_Pipe">
              <mode>Sewage</mode>
            </li>
            <li Class="RimLayers.Compatibility.CompProperties_LayerPort" />
          </comps>
          <uiOrder>2060</uiOrder>
        </ThingDef>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="sewagePipeStuff"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>
        <ThingDef ParentName="DubsDirtyPipeBase">
          <defName>RL_HygieneAirRiser</defName>
          <label>vertical air-con riser</label>
          <description>A duct that also joins the air network of the layer directly above and below it. Build one on each layer at the same position; a riser only spans one layer, so a three-layer shaft needs one on every layer. It is an ordinary duct otherwise.</description>
          <designationCategory>Temperature</designationCategory>
          <graphicData>
            <texPath>DBH/Things/Building/ducting_atlas</texPath>
            <color>(0.45,0.8,1)</color>
          </graphicData>
          <uiIconPath>DBH/UI/coolingPipe</uiIconPath>
          <uiIconScale>0.8</uiIconScale>
          <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>120</WorkToBuild>
          </statBases>
          <costList>
            <Steel>8</Steel>
          </costList>
          <comps>
            <li Class="DubsBadHygiene.CompProperties_Pipe">
              <mode>Air</mode>
            </li>
            <li Class="RimLayers.Compatibility.CompProperties_LayerPort" />
